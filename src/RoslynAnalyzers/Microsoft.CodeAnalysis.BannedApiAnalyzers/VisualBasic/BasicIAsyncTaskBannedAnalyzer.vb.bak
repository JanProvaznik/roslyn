Imports System.Collections.Generic
Imports System.Collections.Immutable
Imports System.Linq
Imports Microsoft.CodeAnalysis.BannedApiAnalyzers
Imports Microsoft.CodeAnalysis.Diagnostics
Imports Microsoft.CodeAnalysis.VisualBasic.Syntax

Namespace Microsoft.CodeAnalysis.VisualBasic.BannedApiAnalyzers
    <DiagnosticAnalyzer(LanguageNames.VisualBasic)>
    Public NotInheritable Class BasicIAsyncTaskBannedAnalyzer
        Inherits IAsyncTaskBannedAnalyzer(Of SyntaxKind)

        Protected Overrides ReadOnly Property XmlCrefSyntaxKind As SyntaxKind
            Get
                Return SyntaxKind.XmlCrefAttribute
            End Get
        End Property

        Protected Overrides ReadOnly Property BaseTypeSyntaxKinds As ImmutableArray(Of SyntaxKind)
            Get
                Return ImmutableArray.Create(SyntaxKind.InheritsStatement, SyntaxKind.ImplementsStatement)
            End Get
        End Property

        Protected Overrides ReadOnly Property SymbolDisplayFormat As SymbolDisplayFormat
            Get
                Return SymbolDisplayFormat.VisualBasicShortErrorMessageFormat
            End Get
        End Property

        Protected Overrides Function GetReferenceSyntaxNodeFromXmlCref(syntaxNode As SyntaxNode) As SyntaxNode
            Return DirectCast(syntaxNode, XmlCrefAttributeSyntax).Reference
        End Function

        Protected Overrides Function GetTypeSyntaxNodesFromBaseType(syntaxNode As SyntaxNode) As IEnumerable(Of SyntaxNode)
            Select Case syntaxNode.Kind()
                Case SyntaxKind.InheritsStatement
                    Return DirectCast(syntaxNode, InheritsStatementSyntax).Types.Cast(Of SyntaxNode)()
                Case SyntaxKind.ImplementsStatement
                    Return DirectCast(syntaxNode, ImplementsStatementSyntax).Types.Cast(Of SyntaxNode)()
                Case Else
                    Return Enumerable.Empty(Of SyntaxNode)()
            End Select
        End Function

        Protected Overrides Function IsMethodDeclaration(node As SyntaxNode) As Boolean
            Return TypeOf node Is MethodBlockSyntax OrElse 
                   TypeOf node Is FunctionBlockSyntax OrElse 
                   TypeOf node Is SubBlockSyntax
        End Function
    End Class
End Namespace
